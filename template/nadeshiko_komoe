<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<style>
    @import url('https://fonts.googleapis.com/css2?family=Zen+Maru+Gothic:wght@500;700;900&display=swap');

    :root {
        --ink: rgba(22, 14, 34, 0.84);
        --orchid: #e196dd;
        --rose: #fda8ba;
        --paper: #f7f1fb;
        --line: rgba(225, 150, 221, 0.6);
    }

    * { box-sizing: border-box; }

    html, body {
        margin: 0;
        padding: 0;
        width: 100vw;
        height: 100vh;
        background: transparent !important;
        overflow: hidden !important;
        display: flex;
        justify-content: center;
        align-items: center;
        font-family: 'Zen Maru Gothic', 'Poppins', sans-serif;
        color: var(--paper);
    }

    .wrapper {
        position: relative;
        width: 100%;
        max-width: 800px;
        height: 200px;
    }

    /* ===== Kotak dialog ala visual novel ===== */
    .box {
        position: absolute;
        left: 0;
        right: 0;
        bottom: 0;
        height: 112px;
        padding: 26px 40px 14px 175px;
        border-radius: 10px;
        border: 2px solid var(--line);
        background: var(--ink);
        box-shadow: 0 6px 18px rgba(0, 0, 0, 0.55);
        overflow: hidden;
        animation: rise 0.45s cubic-bezier(.2, .8, .2, 1) both;
    }

    .box .bg {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        opacity: 0.28;
        z-index: 0;
    }

    .message {
        position: relative;
        z-index: 1;
        display: -webkit-box;
        -webkit-box-orient: vertical;
        -webkit-line-clamp: 3;
        line-clamp: 3;
        overflow: hidden;
        overflow-wrap: anywhere;
        font-size: 17px;
        font-weight: 500;
        line-height: 1.5;
        text-shadow: 0 1px 3px rgba(0, 0, 0, 0.9);
    }

    /* pesan kosong = karakter diam sejenak, seperti di VN */
    .message:empty::before {
        content: "......";
        opacity: 0.6;
    }

    /* penanda "lanjut" khas visual novel */
    .next {
        position: absolute;
        right: 16px;
        bottom: 10px;
        z-index: 1;
        width: 0;
        height: 0;
        border-left: 7px solid transparent;
        border-right: 7px solid transparent;
        border-top: 9px solid var(--rose);
        animation: blink 1.2s ease-in-out infinite;
    }

    /* ===== Papan nama (donatur) ===== */
    .nameplate {
        position: absolute;
        left: 165px;
        bottom: 96px;
        z-index: 4;
        max-width: 330px;
        padding: 4px 22px;
        background: var(--orchid);
        color: #2a1636;
        font-size: 19px;
        font-weight: 900;
        line-height: 1.35;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        transform: skewX(-10deg);
        border-radius: 4px;
        box-shadow: 0 3px 8px rgba(0, 0, 0, 0.45);
        animation: rise 0.45s 0.1s cubic-bezier(.2, .8, .2, 1) both;
    }

    /* ===== Label nominal ===== */
    .amount {
        position: absolute;
        right: 22px;
        bottom: 96px;
        z-index: 4;
        padding: 3px 18px;
        background: var(--ink);
        border: 2px solid var(--rose);
        color: var(--rose);
        font-size: 19px;
        font-weight: 900;
        line-height: 1.35;
        white-space: nowrap;
        transform: skewX(-10deg);
        border-radius: 4px;
        box-shadow: 0 3px 8px rgba(0, 0, 0, 0.45);
        animation: rise 0.45s 0.2s cubic-bezier(.2, .8, .2, 1) both;
    }

    /* ===== Maskot ===== */
    .mascot {
        position: absolute;
        left: 10px;
        bottom: 0;
        z-index: 3;
        height: 188px;
        pointer-events: none;
        animation: slide-in 0.5s 0.05s cubic-bezier(.2, .8, .2, 1) both;
    }

    .mascot img {
        height: 100%;
        width: auto;
        display: block;
        object-fit: contain;
        filter: drop-shadow(3px 4px 5px rgba(0, 0, 0, 0.8));
    }

    @keyframes rise {
        from { opacity: 0; transform: translateY(14px); }
        to   { opacity: 1; transform: translateY(0); }
    }

    /* nameplate & amount memakai skew, jadi keyframe-nya dipisah */
    .nameplate, .amount { animation-name: rise-skew; }
    @keyframes rise-skew {
        from { opacity: 0; transform: translateY(14px) skewX(-10deg); }
        to   { opacity: 1; transform: translateY(0) skewX(-10deg); }
    }

    @keyframes slide-in {
        from { opacity: 0; transform: translateX(-24px); }
        to   { opacity: 1; transform: translateX(0); }
    }

    @keyframes blink {
        0%, 100% { opacity: 1; }
        50%      { opacity: 0.2; }
    }

    @media (prefers-reduced-motion: reduce) {
        .box, .nameplate, .amount, .mascot, .next { animation: none; }
    }
</style>
</head>
<body>

<div class="wrapper">
    <div class="box">
        <img class="bg" alt="" src="https://images3.alphacoders.com/135/thumb-350-1357731.webp" onerror="this.remove()">
        <div class="message">{{message}}</div>
        <span class="next"></span>
    </div>

    <div class="nameplate">{{gifterName}}</div>
    <div class="amount">{{formattedAmount}}</div>

    <div class="mascot">
        <img src="https://raw.githubusercontent.com/manebu889/Tako-Overlay/feat/new-mascots/asset/mascot/Komoe-Nadeshiko.webp" alt="Nadeshiko Mascot">
    </div>
</div>

</body>
</html>